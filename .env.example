# Environment variables for the entire stack (Development)

# ==========================================
# Database Configuration
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nm_interview_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nm_interview_db

MONGO_INITDB_ROOT_USERNAME=mongo
MONGO_INITDB_ROOT_PASSWORD=mongo
MONGO_URI=mongodb://mongo:mongo@localhost:27017/nm_interview_docs?authSource=admin

REDIS_HOST=localhost
REDIS_PORT=6379

# ==========================================
# Microservices Ports
# ==========================================
AUTH_SERVICE_PORT=4001
USER_SERVICE_PORT=4002
INTERVIEW_SERVICE_PORT=4003

# ==========================================
# Security Configuration
# ==========================================
JWT_SECRET=super_secret_jwt_key_for_development
JWT_EXPIRES_IN=1h

# ==========================================
# Frontend Configuration
# ==========================================
VITE_API_BASE_URL=http://localhost:4000
VITE_SOCKET_URL=ws://localhost:4000

# ==========================================
# AI Interviewer Configuration (HR Round)
# ==========================================
LLM_PROVIDER=GROQ # Options: OPENAI, GROQ
LLM_API_KEY=your_groq_api_key_here

